        </mxCell>
        <mxCell id="op-limits" value="&lt;b&gt;Límite de la evidencia&lt;/b&gt;&lt;br&gt;La conexión comprobada corresponde a captura SMTP en pruebas técnicas; no a correos funcionales de identidad.&lt;br&gt;La inicialización administrativa y recuperación no tienen aceptación completa.&lt;br&gt;Mailpit sustituye al correo externo en ensayos; no es proveedor de producción." style="fontFamily=Arial;html=1;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontColor=#1e293b;spacing=5;" vertex="1" parent="1">

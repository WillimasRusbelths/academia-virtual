        <mxCell id="internal-note" value="&lt;b&gt;Capas y dependencias internas&lt;/b&gt;&lt;br&gt;Presentación → aplicación → dominio; infraestructura implementa contratos del núcleo.&lt;br&gt;Las flechas muestran colaboración, no imports. Los módulos contienen sus responsabilidades; no son contenedores Docker." style="text;whiteSpace=wrap;html=1;align=left;fontFamily=Arial;fontSize=13;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="430" y="1565" width="1130" height="55" as="geometry" />
        </mxCell>
        <mxCell id="legend-title" value="&lt;b&gt;Leyenda | Estado del componente (color + texto)&lt;/b&gt;" style="text;html=1;align=left;fontFamily=Arial;fontSize=17;" vertex="1" parent="1">
          <mxGeometry x="40" y="1680" width="720" height="30" as="geometry" />
        </mxCell>
        <mxCell id="legend-implemented" value="Implementado" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#172638;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#e7f3e8;strokeColor=#287343;" vertex="1" parent="1">
          <mxGeometry x="40" y="1725" width="235" height="55" as="geometry" />
        </mxCell>
        <mxCell id="legend-partial" value="Parcialmente implementado" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#172638;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#fff2cf;strokeColor=#ad7900;" vertex="1" parent="1">
          <mxGeometry x="290" y="1725" width="235" height="55" as="geometry" />
        </mxCell>
        <mxCell id="legend-planned" value="Previsto" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#172638;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#eff2f6;strokeColor=#687789;" vertex="1" parent="1">
          <mxGeometry x="540" y="1725" width="235" height="55" as="geometry" />
        </mxCell>
        <mxCell id="connections-legend" value="&lt;b&gt;Estado de la conexión, independiente del componente&lt;/b&gt;&lt;br&gt;Línea azul continua: actual / ensamblada.&lt;br&gt;Línea violeta de puntos: fundamento probado.&lt;br&gt;Línea gris discontinua: prevista.&lt;br&gt;Una conexión actual a un componente parcial no acredita su historia completa." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fontFamily=Arial;fontSize=14;fontColor=#334155;fillColor=#f8fafc;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="840" y="1680" width="750" height="140" as="geometry" />
        </mxCell>
        <mxCell id="cli-note" value="&lt;b&gt;C11 no es un segundo servidor&lt;/b&gt;&lt;br&gt;Reutiliza casos de uso en una ejecución CLI transitoria. No llama por HTTP a los módulos. Sus relaciones se reservan para detalle operativo." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fontFamily=Arial;fontSize=14;fontColor=#334155;fillColor=#f8fafc;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="40" y="1830" width="720" height="115" as="geometry" />
        </mxCell>
        <mxCell id="detail-note" value="&lt;b&gt;Relaciones reservadas para vistas de detalle&lt;/b&gt;&lt;br&gt;Composición C10 (fila 2); entradas/casos de uso y revalidación (fila 7/fila 8/fila 13); auditoría (fila 9); CLI (fila 12); cuotas/persistencia restante (fila 6/fila 10); orden/cobro/cupos (fila 15/fila 17); permisos y metadatos académicos (fila 18/fila 19); web/chat (fila 22); paneles (fila 23).&lt;br&gt;C07, C10, C11 y C19 se muestran sin conexiones para no inventar ni saturar la vista. Las filas 1–23 indican el orden de las relaciones del catálogo; no son nuevos IDs de requisitos." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fontFamily=Arial;fontSize=14;fontColor=#334155;fillColor=#f8fafc;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="840" y="1840" width="1150" height="155" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="&lt;b&gt;Alcance:&lt;/b&gt; Docker Compose validado localmente; no es estilo arquitectónico. Integraciones, recuperación y 1000 concurrentes pendientes.&lt;br&gt;Fuente: docs/02-arquitectura-software/componentes-arquitectonicos.md. Sin flujos completos de registro/login ni disponibilidad de producción acreditada." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fontFamily=Arial;fontSize=14;fontColor=#334155;fillColor=#f8fafc;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="40" y="2010" width="1950" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
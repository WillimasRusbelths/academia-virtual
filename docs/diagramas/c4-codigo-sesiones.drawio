        <mxCell id="legend" value="&lt;b&gt;Convenciones UML&lt;/b&gt;&lt;br&gt;Línea discontinua + triángulo hueco: realización explícita.&lt;br&gt;Línea continua + flecha: asociación dirigida (referencia conservada).&lt;br&gt;Línea discontinua + flecha: dependencia de uso o de tipo.&lt;br&gt;&amp;laquo;función&amp;raquo; y &amp;laquo;interface de datos&amp;raquo; son etiquetas descriptivas.&lt;br&gt;Sin herencia ni composición en esta selección." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontFamily=Arial;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="260.0" y="1370" width="610" height="220" as="geometry" />
        </mxCell>
        <mxCell id="type-note" value="&lt;b&gt;Tipos y límites&lt;/b&gt;&lt;br&gt;Role y AccountStatus: C04 Usuarios.&lt;br&gt;Permission: C05 (profile:read | users:manage).&lt;br&gt;AccountAccess muestra solo campos usados en esta vista.&lt;br&gt;Compatibilidad estructural no equivale a implements.&lt;br&gt;Funciones y datos del dominio no dependen de pg." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontFamily=Arial;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="1870.0" y="1370" width="630" height="210" as="geometry" />

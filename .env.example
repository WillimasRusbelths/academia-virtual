# Configuración local de Compose. Copiar a .env solo si no existe.
# Usar cinco valores aleatorios distintos, hexadecimales de 64 caracteres.
# También se puede generar .env con ops/docker/configure.mjs.
POSTGRES_PASSWORD=
ACADEMIA_OWNER_PASSWORD=
ACADEMIA_RUNTIME_PASSWORD=
PROBE_OWNER_PASSWORD=
PROBE_RUNTIME_PASSWORD=
POSTGRES_PORT=55432
MAILPIT_SMTP_PORT=11025
MAILPIT_HTTP_PORT=18025
API_PORT=3000
WEB_PORT=5173
# Configuración de identidad. Claves de 32 bytes en base64, independientes por entorno.
APP_ENV=development
APP_ORIGIN=http://localhost:5173
MAIL_MODE=capture
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=academia@example.test
MAIL_KEY_ID=local-v1
MAIL_PAYLOAD_KEY=
RATE_HMAC_KEY=
TEST_MAIL_PAYLOAD_KEY=
TEST_RATE_HMAC_KEY=
DB_POOL_MAX=10
TRUSTED_PROXY=
# Las URL privadas las construye Compose; no pegar URL de servicios del host.
DATABASE_URL=
MIGRATION_DATABASE_URL=
TEST_DATABASE_URL=
TEST_MIGRATION_DATABASE_URL=

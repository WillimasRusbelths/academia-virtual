# Variables de pruebas dentro del contenedor api.
# Compose construye las URL desde .env; no copiar ni montar .env.test del host.
# Host db:5432; base academia_v00_test; roles academia_v00_owner/runtime.
PROBE_MIGRATION_URL=
PROBE_DATABASE_URL=
SMTP_HOST=mailpit
SMTP_PORT=1025
MAILPIT_URL=http://mailpit:8025
# Test se selecciona explícitamente; no hereda bases ni claves de desarrollo.
APP_ENV=test
APP_ORIGIN=http://localhost:5173
MAIL_MODE=capture
MAIL_FROM=academia@example.test
MAIL_KEY_ID=test-v1
TEST_DATABASE_URL=
TEST_MIGRATION_DATABASE_URL=
TEST_MAIL_PAYLOAD_KEY=
TEST_RATE_HMAC_KEY=
DB_POOL_MAX=10
TRUSTED_PROXY=

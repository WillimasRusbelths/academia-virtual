{
  "name": "@academia/web",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint src tests playwright.config.ts playwright.academic-offering.config.ts playwright.enrollment.config.ts vite.config.ts eslint.config.js",
    "typecheck:enrollment": "tsc -p tsconfig.enrollment.json",
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "test:unit": "vitest run src",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:enrollment": "npm run test:e2e -- --config playwright.enrollment.config.ts",
    "test:smoke": "vitest run src/app/runtime.test.tsx"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "vite": "^8.0.0"
  }
}

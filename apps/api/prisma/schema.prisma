generator client {
  provider = "prisma-client"
  output = "../generated/identity"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum TokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum AuditActor {
  ACCOUNT
  SYSTEM_BOOTSTRAP
}

enum AuditAction {
  ACCOUNT_CREATED
  BOOTSTRAP_ADMIN_CREATED
  NAME_CHANGED
  ROLE_CHANGED
  STATUS_CHANGED
}

enum AuditResult {
  APPLIED
  NO_CHANGE
}

enum DeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum MailErrorClass {
  TIMEOUT
  TEMPORARY
  PERMANENT
  EXPIRED
}

enum RateScope {
  LOGIN_PAIR
  MAIL_RECIPIENT_PURPOSE
  MAIL_ORIGIN
}

enum RatePhase {
  ADMISSION
  SMTP
}

enum RateResult {
  RESERVED
  FAILED
  ACCEPTED
}

model User {
  id                      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                    String
  email                   String
  emailCanonical          String        @unique
  role                    Role
  status                  AccountStatus @default(ACTIVE)
  emailVerifiedAt         DateTime?     @db.Timestamptz(6)
  passwordHash            String?
  mustSetPassword         Boolean       @default(false)
  provisionalPasswordHash String?
  provisionalExpiresAt    DateTime?     @db.Timestamptz(6)
  authVersion             BigInt        @default(0)
  teacherEligibilityVersion BigInt      @default(0)
  createdAt               DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime      @default(now()) @db.Timestamptz(6)
  disabledAt              DateTime?     @db.Timestamptz(6)
  sessions                Session[]
  actionTokens            ActionToken[]
  auditAsActor            AuditEvent[]  @relation("AuditActor")
  auditAsTarget           AuditEvent[]  @relation("AuditTarget")
  bootstrapState          SystemState?
  academicGroups          AcademicGroup[] @relation("AcademicTeacher")
  academicPublishedGroups AcademicGroup[] @relation("AcademicPublishedTeacher")
  academicCommands        AcademicCommand[]
  academicAuditEvents     AcademicAuditEvent[]
  coursePriceChanges      CoursePrice[]
  reservationRequests     ReservationRequest[]
  enrollmentOrders        EnrollmentOrder[]
  paymentAttempts         PaymentAttempt[]
  enrollments             Enrollment[]
  incidentFollowUps       IncidentFollowUp[]
}

model Session {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash         Bytes    @unique
  userId            String   @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  authVersion       BigInt
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  lastAcceptedAt    DateTime @default(now()) @db.Timestamptz(6)
  absoluteExpiresAt DateTime @db.Timestamptz(6)
  revokedAt         DateTime? @db.Timestamptz(6)
  @@index([userId, revokedAt])
  @@index([absoluteExpiresAt])
}

model ActionToken {
  id                     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String       @db.Uuid
  user                   User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  purpose                TokenPurpose
  tokenHash              Bytes        @unique
  emailCanonicalSnapshot String
  createdAt              DateTime     @default(now()) @db.Timestamptz(6)
  expiresAt              DateTime     @db.Timestamptz(6)
  consumedAt             DateTime?    @db.Timestamptz(6)
  revokedAt              DateTime?    @db.Timestamptz(6)
  mailDelivery           MailDelivery?
  @@index([userId, purpose])
  @@index([expiresAt])
  // La unicidad parcial sin now() se define en 0002_identity_access.
}

model AuditEvent {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorKind    AuditActor
  actorUserId  String?      @db.Uuid
  actor        User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  targetUserId String       @db.Uuid
  target       User         @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  action       AuditAction
  result       AuditResult
  occurredAt   DateTime     @default(now()) @db.Timestamptz(6)
  requestId    String       @db.Uuid
  oldRole      Role?
  newRole      Role?
  oldStatus    AccountStatus?
  newStatus    AccountStatus?
  @@index([targetUserId, occurredAt])
}

model SystemState {
  id                   Int       @id @default(1)
  bootstrapCompletedAt DateTime? @db.Timestamptz(6)
  firstAdminUserId      String?   @unique @db.Uuid
  firstAdmin            User?     @relation(fields: [firstAdminUserId], references: [id], onDelete: Restrict)
}

model MailDelivery {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenId          String?        @unique @db.Uuid
  token            ActionToken?   @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  status           DeliveryStatus @default(PENDING)
  recipientKey     String
  originKey        String
  encryptedPayload Bytes?
  nonce            Bytes?
  authTag          Bytes?
  keyId            String?
  attempts         Int            @default(0)
  nextAttemptAt    DateTime        @default(now()) @db.Timestamptz(6)
  leaseUntil       DateTime?      @db.Timestamptz(6)
  claimId          String?        @db.Uuid
  createdAt        DateTime        @default(now()) @db.Timestamptz(6)
  sentAt           DateTime?      @db.Timestamptz(6)
  finishedAt       DateTime?      @db.Timestamptz(6)
  lastErrorClass   MailErrorClass?
  @@index([status, nextAttemptAt])
  @@index([leaseUntil])
}

model RateBucket {
  key          String     @id
  scope        RateScope
  phase        RatePhase
  blockedUntil DateTime?  @db.Timestamptz(6)
  updatedAt    DateTime    @default(now()) @db.Timestamptz(6)
  events       RateEvent[]
}

model RateEvent {
  id                   String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bucketKey            String
  bucket               RateBucket @relation(fields: [bucketKey], references: [key], onDelete: Restrict)
  occurredAt           DateTime   @default(now()) @db.Timestamptz(6)
  attemptId            String?    @db.Uuid
  status               RateResult
  reservationExpiresAt DateTime?  @db.Timestamptz(6)
  @@index([bucketKey, occurredAt])
}

enum AcademicCourseState {
  DRAFT
  PUBLISHED
  WITHDRAWN
}

enum AcademicGroupState {
  DRAFT
  PUBLISHED
  WITHDRAWN
  CANCELLED
}

enum AcademicResourceKind {
  COURSE
  GROUP
}

enum AcademicOperation {
  COURSE_CREATE
  COURSE_EDIT
  COURSE_PUBLISH
  COURSE_WITHDRAW
  GROUP_CREATE
  GROUP_EDIT
  GROUP_SCHEDULE
  GROUP_PUBLISH
  GROUP_WITHDRAW
  GROUP_CANCEL
}

model AcademicCourse {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  state       AcademicCourseState @default(DRAFT)
  revision    BigInt              @default(1)
  createdAt   DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime            @default(now()) @db.Timestamptz(6)
  groups      AcademicGroup[]
  price       CoursePrice?
  orderItems  EnrollmentOrderItem[]
  enrollments Enrollment[]
}

model AcademicGroup {
  id                                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId                           String             @db.Uuid
  course                             AcademicCourse     @relation(fields: [courseId], references: [id], onDelete: Restrict)
  name                               String
  description                        String?
  state                              AcademicGroupState @default(DRAFT)
  periodStart                        DateTime?          @db.Date
  periodEnd                          DateTime?          @db.Date
  timeZone                           String             @default("America/Lima")
  capacity                           Int?               @db.SmallInt
  teacherUserId                      String?            @db.Uuid
  teacher                            User?              @relation("AcademicTeacher", fields: [teacherUserId], references: [id], onDelete: Restrict)
  publishedTeacherUserId             String?            @db.Uuid
  publishedTeacher                   User?              @relation("AcademicPublishedTeacher", fields: [publishedTeacherUserId], references: [id], onDelete: Restrict)
  publishedTeacherEligibilityVersion BigInt?
  cancellationReason                 String?
  cancelledAt                        DateTime?          @db.Timestamptz(6)
  revision                           BigInt             @default(1)
  createdAt                          DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt                          DateTime           @default(now()) @db.Timestamptz(6)
  slots                              AcademicSlot[]
  orderItems                         EnrollmentOrderItem[]
  enrollments                        Enrollment[]

  @@index([courseId, state, id])
  @@index([teacherUserId, state, id])
  // CHECK, transiciones y búsqueda parcial PUBLISHED en 0005; sin preview Prisma.
}

model AcademicSlot {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId     String        @db.Uuid
  group       AcademicGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  dayOfWeek   Int           @db.SmallInt
  startMinute Int           @db.SmallInt
  endMinute   Int           @db.SmallInt

  @@unique([groupId, dayOfWeek, startMinute, endMinute], map: "AcademicSlot_group_day_start_end_key")
  @@index([groupId, dayOfWeek])
}

model AcademicCommand {
  actorUserId       String               @db.Uuid
  actor             User                 @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  commandId         String               @db.Uuid
  operation         AcademicOperation
  targetKind        AcademicResourceKind
  targetId          String               @db.Uuid
  payloadDigest     Bytes
  resultingRevision BigInt
  appliedAt         DateTime             @default(now()) @db.Timestamptz(6)
  result            AuditResult

  @@id([actorUserId, commandId])
}

model AcademicAuditEvent {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId    String               @db.Uuid
  actor          User                 @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  resourceKind   AcademicResourceKind
  resourceId     String               @db.Uuid
  action         AcademicOperation
  result         AuditResult
  commandId      String               @db.Uuid
  requestId      String               @db.Uuid
  // El estado de curso es el subconjunto sin CANCELLED, protegido también por CHECK.
  beforeState    AcademicGroupState?
  afterState     AcademicGroupState
  beforeRevision BigInt?
  afterRevision  BigInt
  occurredAt     DateTime             @default(now()) @db.Timestamptz(6)

  @@index([resourceKind, resourceId, occurredAt])
}

// AcademicTeacherDirectory y triggers/checks se versionan en SQL, sin vistas experimentales.

enum ReservationRequestState {
  ADMITTED
  CONFIRMED
  REJECTED
}

enum EnrollmentOrderState {
  RESERVED
  ENROLLED
  EXPIRED
}

enum SeatReservationState {
  CONFIRMED
  CONVERTED
  EXPIRED
}

enum PaymentAttemptState {
  SUBMITTING
  PENDING
  INITIATION_UNKNOWN
  FAILED_NO_CHARGE
  APPLIED
  INCIDENT
}

enum ProviderReceiptState {
  RECEIVED
  PROCESSED
}

enum PaymentReconciliationState {
  APPLIED
  INCIDENT
}

enum EnrollmentActorKind {
  ACCOUNT
  SYSTEM
}

model CoursePrice {
  courseId    String         @id @db.Uuid
  course      AcademicCourse @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  amountMinor BigInt
  currency    String         @default("PEN")
  revision    BigInt         @default(1)
  changedBy   String         @db.Uuid
  changedByUser User         @relation(fields: [changedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  changedAt   DateTime       @default(now()) @db.Timestamptz(6)
}

model AdmissionSequence {
  id           Int    @id @default(1)
  nextSequence BigInt @default(1)
}

model DispatchState {
  id Int @id @default(1)
}

model ReservationRequest {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId             String                  @db.Uuid
  student               User                    @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  intentionId           String                  @db.Uuid
  selectionDigest       Bytes
  groupIds              String[]                @db.Uuid
  admittedAt            DateTime                @db.Timestamptz(6)
  admissionSequence     BigInt                  @unique
  actorSessionReference String                  @db.Uuid
  authVersion           BigInt
  state                 ReservationRequestState @default(ADMITTED)
  decisionCode          String?
  decidedAt             DateTime?               @db.Timestamptz(6)
  order                 EnrollmentOrder?

  @@unique([studentId, intentionId])
  @@index([state, admissionSequence])
}

model EnrollmentOrder {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId             String               @db.Uuid
  student               User                 @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  requestId             String               @unique @db.Uuid
  request               ReservationRequest   @relation(fields: [requestId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  currency              String               @default("PEN")
  totalMinor            BigInt
  state                 EnrollmentOrderState @default(RESERVED)
  revision              BigInt               @default(1)
  confirmedAt           DateTime             @db.Timestamptz(6)
  expiresAt             DateTime             @db.Timestamptz(6)
  expirationProcessedAt DateTime?            @db.Timestamptz(6)
  items                 EnrollmentOrderItem[]
  paymentAttempts       PaymentAttempt[]
  verifiedPayments      VerifiedPayment[]
  incidents             PaymentIncident[]

  @@unique([id, studentId])
  @@index([studentId, state, expiresAt])
  @@index([state, expiresAt, id])
  // UNIQUE parcial RESERVED por alumno en SQL; sin predicado dependiente de reloj.
}

model EnrollmentOrderItem {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId              String          @db.Uuid
  order                EnrollmentOrder @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  courseId             String          @db.Uuid
  course               AcademicCourse  @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  groupId              String          @db.Uuid
  group                AcademicGroup   @relation(fields: [groupId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  priceMinor           BigInt
  courseName           String
  groupName            String
  periodStart          DateTime        @db.Date
  periodEnd            DateTime        @db.Date
  timeZone             String          @default("America/Lima")
  groupStartAt         DateTime        @db.Timestamptz(6)
  enrollmentValidUntil DateTime        @db.Timestamptz(6)
  scheduleSnapshot     Json
  reservation          SeatReservation?
  enrollment           Enrollment?

  @@unique([orderId, courseId])
  @@index([groupId, courseId, orderId])
}

model SeatReservation {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderItemId String               @unique @db.Uuid
  orderItem   EnrollmentOrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  state       SeatReservationState @default(CONFIRMED)
  @@index([state, orderItemId])
}

model PaymentAttempt {
  id                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId                String              @db.Uuid
  studentId              String              @db.Uuid
  order                  EnrollmentOrder     @relation(fields: [orderId, studentId], references: [id, studentId], onDelete: Restrict, onUpdate: Restrict)
  student                User                @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  initiationId           String              @db.Uuid
  payloadDigest          Bytes
  state                  PaymentAttemptState @default(SUBMITTING)
  merchantReference      String
  externalIdempotencyKey String
  providerScope          String
  providerReference      String?
  createdAt              DateTime            @default(now()) @db.Timestamptz(6)

  @@unique([studentId, initiationId])
  @@index([state, createdAt, id])
  @@index([orderId])
  // Una iniciación no resuelta por orden: índice único parcial en SQL.
}

model ProviderReceipt {
  integrityConflict           Boolean              @default(false)
  id                          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerScope               String
  deliveryKey                 String?
  merchantReferenceHint       String?
  providerPaymentIdHint       String?
  normalizedEvidenceReference String
  receivedAt                  DateTime             @default(now()) @db.Timestamptz(6)
  externalObservedAt          DateTime?            @db.Timestamptz(6)
  state                       ProviderReceiptState @default(RECEIVED)
  processedAt                 DateTime?            @db.Timestamptz(6)
  terminalPaymentId           String?              @db.Uuid
  terminalPayment             VerifiedPayment?     @relation(fields: [terminalPaymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@index([state, receivedAt, id])
  // Sin FK provisional a orden ni UNIQUE de entrega no acreditada por D02.
}

model VerifiedPayment {
  id                          String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerScope               String
  providerPaymentId           String
  orderId                     String?                    @db.Uuid
  order                       EnrollmentOrder?           @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  amountUnits                 Decimal                    @db.Decimal
  amountScale                 Int
  currency                    String
  merchantReference           String
  verificationFinishedAt      DateTime                   @db.Timestamptz(6)
  reconciliationState         PaymentReconciliationState
  normalizedEvidenceReference String
  receipts                    ProviderReceipt[]
  enrollments                 Enrollment[]
  incidents                   PaymentIncident[]
  @@unique([providerScope, providerPaymentId])
  @@index([orderId])
}

model Enrollment {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderItemId         String              @unique @db.Uuid
  orderItem           EnrollmentOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  studentId           String              @db.Uuid
  student             User                @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  courseId            String              @db.Uuid
  course              AcademicCourse      @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  groupId             String              @db.Uuid
  group               AcademicGroup       @relation(fields: [groupId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  paymentId           String              @db.Uuid
  payment             VerifiedPayment     @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  confirmedAt         DateTime            @db.Timestamptz(6)
  originalPeriodStart DateTime            @db.Date
  originalPeriodEnd   DateTime            @db.Date
  timeZone            String              @default("America/Lima")
  scheduleSnapshot    Json
  validUntil          DateTime            @db.Timestamptz(6)
  @@index([studentId, courseId, validUntil])
  @@index([groupId, validUntil])
}

model PaymentIncident {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId           String?          @db.Uuid
  order             EnrollmentOrder? @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  verifiedPaymentId String           @db.Uuid
  verifiedPayment   VerifiedPayment  @relation(fields: [verifiedPaymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reason            String
  affectedGroupIds  String[]         @db.Uuid
  openedAt          DateTime         @default(now()) @db.Timestamptz(6)
  followUps         IncidentFollowUp[]
  @@unique([verifiedPaymentId, reason])
  @@index([orderId, openedAt])
  @@index([affectedGroupIds], type: Gin)
}

model IncidentFollowUp {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  incidentId  String          @db.Uuid
  incident    PaymentIncident @relation(fields: [incidentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  adminUserId String          @db.Uuid
  admin       User            @relation(fields: [adminUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  commandId   String          @db.Uuid
  recordedAt  DateTime        @default(now()) @db.Timestamptz(6)
  content     String
  @@unique([adminUserId, commandId])
  @@index([incidentId, recordedAt, id])
}

model EnrollmentCommand {
  actorKind         EnrollmentActorKind
  actorReference    String
  commandId         String              @db.Uuid
  operation         String
  payloadDigest     Bytes
  outcomeCode       String
  resourceReferences Json
  resultingRevision BigInt
  appliedAt         DateTime            @default(now()) @db.Timestamptz(6)
  @@id([actorKind, actorReference, commandId])
}

model EnrollmentAuditEvent {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorKind      EnrollmentActorKind
  actorReference String
  operation      String
  targetKind     String
  targetId       String              @db.Uuid
  commandId      String?             @db.Uuid
  providerEventId String?
  effectKey      String?             @unique
  requestId      String              @db.Uuid
  occurredAt     DateTime            @default(now()) @db.Timestamptz(6)
  beforeRevision BigInt?
  afterRevision  BigInt?
  result         String
  @@index([targetKind, targetId, occurredAt])
}

// CHECK, coordinadoras iniciales, índices parciales e inmutabilidad: 0006_enrollment.
